# Paths are resolved relative to this visualizer directory, not the shell.
# This sibling worktree is read-only to the application.
VISUALIZER_RESEARCH_DATA_ROOT=..\..\RL-UAV-Extended-lrppo-clutter

# Existing Python runtime with the research project's scientific dependencies.
# Set an absolute executable path; do not install/update the research environment.
VISUALIZER_SIMULATION_PYTHON=
VISUALIZER_EPISODE_TIMEOUT_SECONDS=900
VISUALIZER_FRONTEND_ORIGIN=http://127.0.0.1:5173
